# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8100/api/v1

# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3100
DATABASE_URL=postgresql+asyncpg://aidoc:aidoc@postgres:5432/aidoc

# Retrieval
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=document_chunks
SEARCH_PROVIDER=opensearch
OPENSEARCH_URL=http://opensearch:9200
ELASTICSEARCH_URL=http://elasticsearch:9200
SEARCH_INDEX=document-chunks
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Object storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
MINIO_SECURE=false

# OpenAI-compatible Qwen/VLLM endpoint
QWEN_BASE_URL=http://vllm:8000/v1
QWEN_API_KEY=demo-key
QWEN_PRIMARY_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
QWEN_FALLBACK_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
HF_TOKEN=

# Langfuse (optional; tracing activates when keys are present)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Docker build: true installs PaddleOCR 3.x + PaddlePaddle in the API image
INSTALL_OCR=false
INSTALL_CRAWL=false
